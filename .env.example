# ── Server ────────────────────────────────────────────────────────────────
PORT=8000
SECRET_KEY=solospark-local-secret-key

# Database (SQLAlchemy URL; defaults to local SQLite)
DATABASE_URL=sqlite:///solospark.db

# ── Local LLM (LM Studio / Unsloth Desktop — OpenAI-compatible) ──────────
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=local-model

# ── Google Places API (New) ───────────────────────────────────────────────
PLACES_API_KEY=AIzaSy...

# ── Cloudflare R2 / AWS S3 ────────────────────────────────────────────────
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=solospark-previews
R2_PUBLIC_BASE_URL=https://preview.solospark.net

# ── Outreach email (Resend API or SMTP fallback) ──────────────────────────
RESEND_API_KEY=re_...
OUTREACH_FROM_EMAIL=aaron@solosparkmail.com
BUSINESS_PHYSICAL_ADDRESS=SoloSpark LLC, Roseburg, OR 97470
# Optional SMTP fallback when RESEND_API_KEY is not set
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Max outreach emails per hour (domain reputation protection)
OUTREACH_RATE_LIMIT_PER_HOUR=5

# ── Stripe billing ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

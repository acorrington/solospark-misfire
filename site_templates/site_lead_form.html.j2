{# Shared lead-capture form, included by index (bottom) and contact subpage.
   Posts to the platform relay (Phase 9) which emails the business owner. #}
<form action="{{ form_action }}" method="post" class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm space-y-5">
  <input type="hidden" name="business_slug" value="{{ business.slug }}" />
  <div>
    <label for="lead-name" class="block text-sm font-medium text-slate-700 mb-1">Your Name</label>
    <input id="lead-name" type="text" name="name" required
           class="w-full rounded-xl border-slate-300 border px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[var(--sp-primary)]" />
  </div>
  <div>
    <label for="lead-phone" class="block text-sm font-medium text-slate-700 mb-1">Phone Number</label>
    <input id="lead-phone" type="tel" name="phone" required
           class="w-full rounded-xl border-slate-300 border px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[var(--sp-primary)]" />
  </div>
  <div>
    <label for="lead-message" class="block text-sm font-medium text-slate-700 mb-1">How can we help?</label>
    <textarea id="lead-message" name="message" rows="4" required
              class="w-full rounded-xl border-slate-300 border px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[var(--sp-primary)]"></textarea>
  </div>
  <button type="submit" class="sp-btn w-full rounded-xl text-white font-semibold px-6 py-4">{{ copy.cta_text }}</button>
</form>

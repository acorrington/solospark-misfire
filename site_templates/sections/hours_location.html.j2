    <!-- ── Hours & Location ─────────────────────────────────────────────── -->
    <section id="hours_location" class="py-20 sm:py-24 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand mb-3">Visit Us</p>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">Hours &amp; Location</h2>
        </div>

        <div class="grid gap-8 lg:grid-cols-2 max-w-5xl mx-auto items-start">
          <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4">Opening Hours</p>
            <ul class="divide-y divide-slate-100">
              {% for entry in copy.hours %}
              <li class="flex items-center justify-between gap-4 py-2.5 text-sm">
                <span class="font-medium text-slate-700">{{ entry.day }}</span>
                <span class="text-slate-600 text-right">{{ entry.hours }}</span>
              </li>
              {% endfor %}
            </ul>
          </div>

          <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4">Where to Find Us</p>
            {% if business.address %}
            <p class="text-slate-700 font-medium leading-relaxed">{{ business.address }}</p>
            {% endif %}
            {% if business.city %}
            <p class="mt-3 text-sm text-slate-500">Serving {{ business.city }} and the surrounding area.</p>
            {% endif %}
            {% if business.phone %}
            <a href="tel:{{ business.phone | tel_href }}" class="mt-4 inline-block text-lg font-bold text-slate-900 hover:text-brand transition-colors">{{ business.phone }}</a>
            {% endif %}
          </div>
        </div>
      </div>
    </section>

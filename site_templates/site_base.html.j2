<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block page_title %}{{ business.name }}{% endblock %}</title>
  <meta name="description" content="{% block meta_description %}{{ copy.hero_subheadline }}{% endblock %}" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root { --sp-primary: {{ theme.primary }}; --sp-secondary: {{ theme.secondary }}; }
    .sp-btn { background-color: var(--sp-primary); transition: background-color 0.15s ease; }
    .sp-btn:hover { background-color: var(--sp-secondary); }
    .sp-tint { background-color: color-mix(in srgb, var(--sp-primary) 12%, #ffffff); color: var(--sp-primary); }
    .sp-hero-bg { background: linear-gradient(to bottom, color-mix(in srgb, var(--sp-primary) 10%, #ffffff), #ffffff); }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased">

  {# ── Shared sticky header: brand + nav + click-to-call ──────────────────── #}
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <a href="index.html" class="text-lg font-bold tracking-tight text-slate-900 truncate">{{ business.name }}</a>
      <nav class="flex flex-wrap items-center gap-1 order-3 w-full md:w-auto md:order-none justify-center md:justify-end">
        {% for item in nav_items %}
        <a href="{{ item.href }}"
           class="px-3 py-2 rounded-lg text-sm font-medium {% if item.href == active_href %}bg-slate-900/5 text-slate-900{% else %}text-slate-600 hover:text-slate-900 hover:bg-slate-100{% endif %}">{{ item.label }}</a>
        {% endfor %}
        {% if business.phone %}
        <a href="tel:{{ business.phone | tel_href }}"
           class="sp-btn inline-flex items-center gap-2 rounded-full text-white font-semibold px-4 py-2 text-sm whitespace-nowrap ml-1">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          {{ business.phone }}
        </a>
        {% endif %}
      </nav>
    </div>
  </header>

  <main>
    {% block content %}{% endblock %}
  </main>

  {# ── Shared footer ──────────────────────────────────────────────────────── #}
  <footer class="bg-slate-900 text-slate-300">
    <div class="max-w-6xl mx-auto px-4 py-10 text-center space-y-2 text-sm">
      <p class="font-semibold text-white">{{ business.name }}</p>
      {% if business.address %}
      <p>{{ business.address }}</p>
      {% endif %}
      {% if business.phone %}
      <p><a href="tel:{{ business.phone | tel_href }}" class="hover:text-white transition-colors">{{ business.phone }}</a></p>
      {% endif %}
      <p>&copy; {{ current_year }} {{ business.name }}. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>

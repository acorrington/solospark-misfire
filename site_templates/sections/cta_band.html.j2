    <!-- ── CTA band ─────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden bg-gradient-to-r from-ink to-brand-dark py-16 sm:py-20">
      <div class="absolute -top-24 right-10 w-96 h-96 rounded-full blur-3xl opacity-20" style="background: {{ copy.brand.primary }}"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
        <div class="max-w-xl">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">{{ copy.cta_text }}</h2>
          <p class="mt-3 text-slate-200/90">{{ copy.cta_band_subtext }}</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 shrink-0">
          {% if business.phone %}
          <a href="tel:{{ business.phone | tel_href }}"
             class="inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-100 text-slate-900 font-semibold px-7 py-3.5 rounded-full shadow-lg transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/></svg>
            {{ business.phone }}
          </a>
          {% endif %}
          <a href="#contact"
             class="inline-flex items-center justify-center border border-white/50 hover:bg-white/10 text-white font-semibold px-7 py-3.5 rounded-full transition-colors">
            Send a message
          </a>
        </div>
      </div>
    </section>

    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden">
      {% if copy.hero_image_url %}
      <div class="absolute inset-0">
        <img src="{{ copy.hero_image_url }}" alt="" class="w-full h-full object-cover" aria-hidden="true" />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-slate-950/40"></div>
      </div>
      {% else %}
      <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800"></div>
      <div class="absolute -top-32 -right-24 w-[36rem] h-[36rem] rounded-full blur-3xl opacity-25" style="background: {{ copy.brand.primary }}"></div>
      <div class="absolute -bottom-40 -left-24 w-[28rem] h-[28rem] rounded-full blur-3xl opacity-15" style="background: {{ copy.brand.primary }}"></div>
      {% endif %}

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-24 sm:pt-28 sm:pb-32">
        <p class="text-xs sm:text-sm font-semibold uppercase tracking-[0.25em] text-white/70 mb-5">{{ copy.tagline }}</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.08] max-w-3xl">{{ copy.hero_headline }}</h1>
        <p class="mt-6 text-lg sm:text-xl text-slate-200/90 leading-relaxed max-w-2xl">{{ copy.hero_subheadline }}</p>

        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a href="#contact"
             class="inline-flex items-center justify-center bg-brand hover:bg-brand-dark text-white font-semibold px-8 py-4 rounded-full shadow-lg shadow-black/20 transition-colors">
            {{ copy.cta_text }}
          </a>
          {% if business.phone %}
          <a href="tel:{{ business.phone | tel_href }}"
             class="inline-flex items-center justify-center gap-2 border border-white/40 hover:bg-white/10 text-white font-semibold px-8 py-4 rounded-full transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/></svg>
            Call {{ business.phone }}
          </a>
          {% endif %}
        </div>

        {% if business.rating or business.review_count %}
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-white/85">
          {% if business.rating %}
          <span class="inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-amber-400"><path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.543.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.762-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd"/></svg>
            <span class="font-semibold text-white">{{ business.rating }}</span> rating
          </span>
          {% endif %}
          {% if business.review_count %}
          <span>{{ business.review_count }} Google reviews</span>
          {% endif %}
          {% if business.city %}
          <span class="inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4 text-white/70"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
            Serving {{ business.city }}
          </span>
          {% endif %}
        </div>
        {% endif %}
      </div>
    </section>
